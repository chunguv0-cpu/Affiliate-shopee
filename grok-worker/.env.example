# Grok Image Worker — biến môi trường (CHẠY NGOÀI Vercel)
PORT=8080
# Phải KHỚP GROK_GATEWAY_SECRET bên app. Bảo vệ endpoint /generate.
GROK_GATEWAY_SECRET=

# Cookie tài khoản Grok: dán JSON mảng cookie (export từ trình duyệt) HOẶC trỏ file.
# Định dạng mỗi cookie: { "name": "...", "value": "...", "domain": ".grok.com", "path": "/" }
GROK_COOKIES=
GROK_COOKIES_FILE=./cookies.json

# User-Agent PHẢI khớp trình duyệt lúc lấy cookie (nếu lệch dễ bị đăng xuất/chặn).
GROK_USER_AGENT=

# Proxy (khuyến nghị residential; X chặn datacenter IP). Vd: http://user:pass@host:port
GROK_PROXY=

# URL trang tạo ảnh + selector (CHỈNH theo UI Grok hiện tại).
GROK_URL=https://grok.com/
GROK_PROMPT_SELECTOR=textarea
GROK_SUBMIT_SELECTOR=button[type="submit"]
GROK_IMAGE_SELECTOR=img[src^="https"]

GROK_NAV_TIMEOUT_MS=60000
GROK_GEN_TIMEOUT_MS=90000
