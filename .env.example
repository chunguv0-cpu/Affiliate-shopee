# =============================================================================
# Shopee Affiliate Auto Agent — Mẫu biến môi trường
# Sao chép file này thành .env.local rồi điền giá trị thật.
#   cp .env.example .env.local        (macOS/Linux)
#   Copy-Item .env.example .env.local (Windows PowerShell)
#
# CẢNH BÁO: KHÔNG commit .env.local. KHÔNG điền giá trị thật vào file mẫu này.
# =============================================================================

# --- AI Provider ---
# Giá trị: mock | v98 | openai
# Mặc định "mock" để chạy local không cần API key.
AI_PROVIDER=mock

# --- V98 (server-side only — KHÔNG để lộ ra client) ---
# Key CHUNG (cũ) — vẫn dùng làm fallback nếu chưa tách 2 key bên dưới.
V98_API_KEY=
V98_BASE_URL=
V98_MODEL=

# --- 2 KEY V98 TÁCH BIỆT (khuyến nghị) ---
# Prompt key: CHỈ dùng cho text/caption/phân tích/sinh prompt. KHÔNG dùng cho ảnh.
V98_PROMPT_API_KEY=
V98_PROMPT_BASE_URL=
V98_PROMPT_MODEL=gemini-2.5-flash
# Image key: CHỈ dùng cho sinh 1 ảnh HERO. KHÔNG dùng cho text.
V98_IMAGE_API_KEY=
V98_IMAGE_BASE_URL=
# (V98_IMAGE_MODEL đặt ở khối Creative bên dưới, mặc định nano-banana-2)
IMAGE_PROMPT_PROVIDER=v98_prompt
IMAGE_IMAGE_PROVIDER=v98_image
PROMPT_PROVIDER_TIMEOUT_MS=12000
# Trần lượt gọi prompt key (text) mỗi chiến dịch/ngày + toàn hệ thống/ngày.
PROMPT_API_MAX_CALLS_PER_CAMPAIGN_PER_DAY=200
PROMPT_API_MAX_CALLS_GLOBAL_PER_DAY=2000
IMAGE_API_MAX_CALLS_PER_POST=1
IMAGE_API_MAX_CALLS_PER_CAMPAIGN_PER_DAY=20
IMAGE_API_MAX_CALLS_GLOBAL_PER_DAY=100
IMAGE_PROVIDER_FALLBACK_ENABLED=true

# --- HOTFIX: chặn API ảnh từ quét/import/validate sản phẩm (chống trừ tiền V98 Image Key) ---
# Guard kiểu DENYLIST: chỉ chặn các flow quét/import/validate; KHÔNG chặn nhầm creative worker.
# LƯU Ý: KHÔNG dùng IMAGE_GENERATION_ENABLED nữa (đã gỡ — nó từng tắt nhầm cả creative worker
# gây lỗi IMAGE_GENERATION_DISABLED). Muốn tắt hẳn sinh ảnh -> đặt IMAGE_PROVIDER=mock hoặc none.
# Tùy chọn siết chặt (chỉ cho creative gọi API ảnh). Mặc định false để KHÔNG chặn nhầm.
IMAGE_GENERATION_ALLOWED_ONLY_IN_CREATIVE_WORKER=false

# --- HOTFIX: kiểm chứng link sản phẩm (sản phẩm chết -> không Sẵn sàng, không tạo bài) ---
PRODUCT_LINK_VALIDATION_ENABLED=true
PRODUCT_LINK_VALIDATION_TTL_HOURS=24
# Số link kiểm tra mỗi lần bấm "Kiểm tra lại toàn bộ link" (batch nhỏ, không xóa dữ liệu).
REVALIDATE_LINKS_BATCH_SIZE=20

# --- OpenAI (server-side only — KHÔNG để lộ ra client) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Creative Image Generation (Phase 17) ---
# Giá trị: v98 | openai | mock | none | grok_gateway. Mặc định tự chọn v98 nếu V98 đã cấu hình.
# Khi IMAGE_PROVIDER=v98: KHÔNG cần OPENAI_API_KEY và KHÔNG cần OPENAI_IMAGE_MODEL.
IMAGE_PROVIDER=v98

# --- Grok image qua cookie (worker chạy NGOÀI Vercel) ---
# Đặt IMAGE_PROVIDER=grok_gateway để dùng. App KHÔNG giữ cookie — chỉ gọi worker.
# Worker (Playwright + cookie tài khoản Grok + proxy) tự host; xem thư mục grok-worker/.
GROK_GATEWAY_URL=
GROK_GATEWAY_SECRET=
GROK_GATEWAY_MODEL=grok-image
GROK_GATEWAY_TIMEOUT_MS=50000
# Khi worker lỗi / cookie hết hạn -> tự fallback: v98 | openai | mock | none
GROK_GATEWAY_FALLBACK=v98
# Model ảnh của V98 Image Key. PHẢI là model V98 hỗ trợ, nếu sai -> lỗi sinh ảnh.
# Xem danh sách model thật: GET /api/debug/v98-models (Bearer CRON_SECRET trên production).
# Ví dụ thường gặp: nano-banana-2, gpt-image-1, dall-e-3, flux... (tùy gói V98 của bạn).
V98_IMAGE_MODEL=nano-banana-2
# Model ảnh OpenAI (chỉ dùng khi IMAGE_PROVIDER=openai).
OPENAI_IMAGE_MODEL=gpt-image-1
# Bucket Supabase Storage lưu ảnh (mặc định post-creatives nếu để trống). Bucket phải public.
CREATIVE_BUCKET=post-creatives
# V98 cost + local overlay controls.
V98_MAX_IMAGE_CALLS_PER_POST=2
CREATIVE_REUSE_EXISTING_ASSETS=true
CREATIVE_ENABLE_LOCAL_STICKERS=true
# Mặc định: 1 ảnh AI HERO (V98 Image Key) + 3 ảnh nguồn Shopee enhance local = đúng 1 lượt gọi ảnh/bài.
CREATIVE_DEFAULT_PACK_MODE=1_AI_3_SOURCE
CREATIVE_RENDER_TEXT_LOCALLY=true
# Optional: CLEAN | DEAL | LIFESTYLE. Empty = auto-pick a consistent template per post.
CREATIVE_TEMPLATE_PRESET=
# Legacy fallback: 1 source product image + 3 grounded AI images = 4 images total.
AI_JOB_AI_IMAGE_COUNT=3
# Space out image steps and retry 429 without hammering the provider.
AI_JOB_IMAGE_STEP_COOLDOWN_MS=45000
AI_JOB_RETRY_DELAY_MS=60000
AI_JOB_RATE_LIMIT_RETRY_DELAY_MS=180000
AI_JOB_MAX_RETRY_DELAY_MS=900000
# Fast path: if Shopee/Open API returns enough source images, use 4 real product images as the album and skip image generation API.
AI_JOB_FAST_SOURCE_ALBUM=true
AI_JOB_FAST_SOURCE_ALBUM_MIN_IMAGES=4
# Add code-rendered text/sticker overlays to fast source album images 2-4. No image-generation API call.
AI_JOB_ENHANCE_SOURCE_ALBUM=true
# Legacy hybrid album: first 2 images are AI-generated, last 2 images are real product images.
# Kept for compatibility; CREATIVE_DEFAULT_PACK_MODE=2_SOURCE_2_AI takes priority.
AI_JOB_HYBRID_AI_FIRST_ALBUM=false
AI_JOB_HYBRID_AI_IMAGE_COUNT=2
AI_JOB_HYBRID_SOURCE_IMAGE_COUNT=2

# --- Shopee image source (Phase 17.6) ---
# server_fetch (mặc định) | browserless | manual_fallback
SHOPEE_IMAGE_SOURCE_PROVIDER=server_fetch
# Browserless (remote Chromium) — chỉ cần khi SHOPEE_IMAGE_SOURCE_PROVIDER=browserless.
# Ví dụ: wss://chrome.browserless.io  (token điền riêng bên dưới hoặc kèm trong endpoint)
BROWSERLESS_WS_ENDPOINT=
BROWSERLESS_API_TOKEN=
# Browserless built-in proxy (khuyến nghị nếu plan hỗ trợ): residential | datacenter...
# KHONG dan 9proxy vao BROWSERLESS_PROXY; 9proxy nen dat o BROWSERLESS_PROXY_URL.
# Code van tu nhan dien host:port:user:pass neu lo dat vao BROWSERLESS_PROXY.
BROWSERLESS_PROXY=
# Mã quốc gia proxy, ví dụ vn, sg, us. Với Shopee VN nên thử vn hoặc sg.
BROWSERLESS_PROXY_COUNTRY=vn
BROWSERLESS_PROXY_STICKY=true
BROWSERLESS_PROXY_LOCALE_MATCH=true
# Proxy riêng nếu không dùng proxy built-in Browserless.
# Ví dụ: http://user:pass@host:port, http://host:port
# Hoặc format 9proxy sticky: host:port:name:pass
BROWSERLESS_PROXY_URL=
# external = Browserless externalProxyServer (mặc định). Nếu không ăn, thử chrome_arg.
BROWSERLESS_PROXY_MODE=external
# Mặc định bật stealth và timeout 60s cho phiên Browserless.
BROWSERLESS_STEALTH=true
BROWSERLESS_TIMEOUT_MS=60000
# Fallback tu dong khi Shopee chan page/API/browser: auto | tavily | google_cse | off.
# auto se dung TAVILY_API_KEY truoc, neu khong co thi dung GOOGLE_CSE_API_KEY/GOOGLE_CSE_CX.
SHOPEE_IMAGE_SEARCH_FALLBACK_PROVIDER=auto
# Mac dinh true de tranh lay nham anh san pham tuong tu khi ten qua chung chung.
SHOPEE_IMAGE_SEARCH_FALLBACK_STRICT=true

# --- Product Data Provider (Phase 17.11) — nguồn ảnh/sản phẩm tự động ---
# none (mặc định, dùng Capture/Browserless) | apify | custom_api
PRODUCT_DATA_PROVIDER=none
# Mã quốc gia gửi cho provider (Shopee VN = VN).
PRODUCT_DATA_COUNTRY=VN
# Apify: token + actor (mặc định gio21~shopee-scraper). Lấy token ở console.apify.com.
APIFY_TOKEN=
APIFY_SHOPEE_ACTOR=gio21~shopee-scraper
# custom_api: API riêng của bạn (POST {BASE_URL}/product-data). Cho nguồn khác sau này.
PRODUCT_DATA_API_BASE_URL=
PRODUCT_DATA_API_KEY=

# --- AI Campaign Autopilot (Phase 19) ---
# Giới hạn batch mỗi lần chạy autopilot (tránh timeout / tốn V98 / job trùng).
CRON_SOFT_TIMEOUT_MS=20000
CRON_HARD_TIMEOUT_MS=25000
IMAGE_PROVIDER_TIMEOUT_MS=22000
MAX_CAMPAIGN_PRODUCTS_PER_RUN=2
MAX_LINK_CONVERSIONS_PER_RUN=2
MAX_PRODUCTS_CREATED_PER_RUN=2
MAX_POSTS_CREATED_PER_RUN=2
MAX_CREATIVE_JOBS_STARTED_PER_RUN=1
MAX_AI_JOB_STEPS_PER_RUN=1
# Một cron call có thể chạy nhiều micro-step an toàn để không cần bấm tay liên tục.
MAX_MICRO_STEPS_PER_CRON_RUN=6
MAX_SECONDS_PER_CRON_RUN=20
AUTOPILOT_CRON_INTERVAL_SECONDS=60
# Số campaign run xử lý mỗi lần gọi cron autopilot (round-robin, song song).
MAX_CAMPAIGNS_PER_CRON_RUN=2
# Legacy alias: vẫn được đọc nếu MAX_CAMPAIGNS_PER_CRON_RUN để trống.
MAX_CAMPAIGN_RUNS_PER_CRON=2
# Round-robin công bằng: mỗi chiến dịch chỉ chạy tối đa N micro-step/cron; tổng toàn cron.
MAX_MICRO_STEPS_PER_CAMPAIGN_PER_RUN=2
MAX_TOTAL_MICRO_STEPS_PER_CRON_RUN=6
# Trần ảnh V98 mỗi cron + số job ảnh song song (worker creative).
MAX_IMAGE_CALLS_PER_CRON_RUN=1
MAX_PARALLEL_IMAGE_JOBS=1
# Khóa campaign chống xử lý trùng khi cron chồng nhau (giây).
AUTOPILOT_LOCK_TTL_SECONDS=120
# Trần chi phí V98 (ảnh AI): mỗi bài, mỗi chiến dịch/ngày, toàn hệ thống/ngày.
V98_MAX_IMAGE_CALLS_PER_CAMPAIGN_PER_DAY=20
V98_MAX_IMAGE_CALLS_GLOBAL_PER_DAY=80
V98_ENABLE_IMAGE_CACHE=true
V98_MAX_IMAGE_CALLS_PER_POST=2
CREATIVE_FAST_SOURCE_ONLY=false
# Trần lượt gọi AI text / Shopee API mỗi chiến dịch/ngày (tham khảo).
AI_MAX_TEXT_CALLS_PER_CAMPAIGN_PER_DAY=80
SHOPEE_MAX_API_CALLS_PER_CAMPAIGN_PER_DAY=200
# Chống lặp sản phẩm/cơ hội trong N ngày gần đây.
PRODUCT_NOVELTY_WINDOW_DAYS=30
ALLOW_REPEAT_PRODUCTS=false
# Provider tìm sản phẩm Shopee cho autopilot: none | shopee_api | custom_api
SHOPEE_PRODUCT_SEARCH_PROVIDER=shopee_api
# Provider chuyển link sản phẩm -> link affiliate: none | shopee_api | custom_api
SHOPEE_AFFILIATE_LINK_PROVIDER=shopee_api
# Khung giờ đăng mặc định (giờ VN) khi posting_plan không có windows.
AUTOPILOT_DEFAULT_WINDOWS=09:00,12:30,20:30

# --- User-side Capture (Phase 17.7) ---
# Secret để bookmarklet gửi ảnh sản phẩm về app. Đặt 1 chuỗi ngẫu nhiên dài.
PRODUCT_CAPTURE_SECRET=
# NEXT_PUBLIC_APP_URL phải là URL thật của app (vd https://your-app.vercel.app) để bookmarklet POST đúng địa chỉ.

# --- Supabase ---
# URL có thể public. SERVICE_ROLE_KEY là server-side only, TUYỆT ĐỐI không expose ra browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Facebook (server-side only — KHÔNG để lộ ra client) ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Market Research (Phase 13.1, server-side only) ---
# Giá trị: mock | tavily | google_cse  (mặc định mock để chạy local không cần key)
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- App / Cron ---
# Chuỗi bí mật ngẫu nhiên, dài (>= 32 ký tự). Dùng để bảo vệ cron route.
# Khi deploy Vercel: set biến này trong Environment Variables; Vercel Cron sẽ
# tự gửi header "Authorization: Bearer <CRON_SECRET>" khi gọi route.
CRON_SECRET=your-random-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
